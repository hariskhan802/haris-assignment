# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4400
# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml (host port 5433 -> container 5432 to avoid
# clashing with a Postgres you may already run locally on 5432).
DATABASE_URL=postgresql://finchat:finchat@localhost:5433/finchat

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# "gemini" = real Google Gemini API (requires GEMINI_API_KEY)
# "mock"   = offline rule-based test double, no network/key needed (dev + CI only)
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Any Gemini model that supports function calling. "-latest" aliases are rolling, so
# they keep working when Google retires a pinned version for new API keys. The lite
# tier is used because this is a parameter-extraction task, and it has the most
# generous free-tier rate limit. List what your key can reach with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=gemini-flash-lite-latest

# Safety rail: how many tool-call rounds the orchestrator will run for one
# user message before giving up (prevents an infinite LLM <-> backend loop).
MAX_TOOL_ROUNDS=5
